# Adapter Information For Communicating With DLR Dataspace Connector
BASE_URL_DLR_CONNECTOR= # e.g., "https://vision-x-api.base-x-ecosystem.org/connectors/xxxxxxxx"
API_KEY_DLR_CONNECTOR= # e.g., sk-...


# Adapter Information For Communicating With T-System Dataspace Connector
BASE_URL_TS_CONNECTOR= # e.g., "https://xxx-xxxxxx-de.rox-test.lila.dih.telekom.com"
API_KEY_TS_CONNECTOR= # api key

# Ports to be exposed
KIT_API_PORT=8080
KIT_FRONTEND_PORT=8088
CATALOG_PORT=8000

# Docker sock from the host
# By default, /var/run/docker.sock
# Rootless docker has different location: e.g., /run/user/1002/docker.sock
DOCKER_SOCKET_HOST=/var/run/docker.sock

# local directory path where the dataspace assets from KITs will be saved
ARTIFACT_HOST_ROOT= /home/dataspace/artifacts # e.g., /home/...

DATABASE_URL=postgresql+psycopg://admin:admin@db:5432/workflowdb
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
ARTIFACT_ROOT=/artifacts
CELERY_WORKER_CONCURRENCY=4
SCHEDULER_POLL_INTERVAL=0.5
ARTIFACT_RETENTION=3600
RETAIN_FAILED_ARTIFACTS=true
